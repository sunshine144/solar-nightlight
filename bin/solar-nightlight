#!/usr/bin/env python3
"""
solar-nightlight - Astronomical Solar Nightlight Daemon for Hyprland / Omarchy
Calculates real-time sunrise, sunset, and twilight times based on geolocation
and smoothly shifts hyprsunset color temperature between day and night.
"""

import os
import sys
import stat
import math
import time
import json
import tempfile
import argparse
import subprocess
import urllib.request
from datetime import datetime, timezone, timedelta
from pathlib import Path

CONFIG_DIR = Path.home() / ".config" / "solar-nightlight"
CACHE_DIR = Path.home() / ".cache" / "solar-nightlight"
LOCATION_CACHE_FILE = CACHE_DIR / "location.json"
STATE_FILE = CACHE_DIR / "state.json"

MAX_HTTP_BYTES = 64 * 1024
MAX_FILE_BYTES = 64 * 1024

DEFAULT_DAY_TEMP = 6500
DEFAULT_NIGHT_TEMP = 4000
DEFAULT_TRANSITION_MINUTES = 45
DEFAULT_INTERVAL_SECONDS = 15

# Fallback coordinates (Central FL / default fallback if completely offline on first run)
FALLBACK_LOCATION = {
    "lat": 38.9072,
    "lon": -77.0369,
    "city": "Washington",
    "region": "District of Columbia"
}



def get_safe_dir_fd(base_path, components):
    fd = os.open(base_path, os.O_RDONLY | os.O_DIRECTORY | getattr(os, "O_NOFOLLOW", 0))
    try:
        for part in components:
            try:
                os.mkdir(part, 0o700, dir_fd=fd)
            except FileExistsError:
                pass
            next_fd = os.open(part, os.O_RDONLY | os.O_DIRECTORY | getattr(os, "O_NOFOLLOW", 0), dir_fd=fd)
            os.close(fd)
            fd = next_fd
    except Exception:
        os.close(fd)
        raise
    return fd


def get_cache_dir_fd():
    home = str(Path.home())
    fd = get_safe_dir_fd(home, [".cache", "solar-nightlight"])
    st = os.fstat(fd)
    if st.st_uid != os.getuid() or stat.S_IMODE(st.st_mode) != 0o700:
        os.close(fd)
        raise RuntimeError("Insecure cache directory")
    return fd

def safe_read_json(file_path: Path, max_bytes: int = MAX_FILE_BYTES):
    """Safely reads a JSON file using dir-fd and O_NOFOLLOW to prevent symlink attacks."""
    try:
        dir_fd = get_cache_dir_fd()
    except Exception:
        return None
    try:
        flags = os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0) | getattr(os, "O_NONBLOCK", 0)
        fd = os.open(file_path.name, flags, dir_fd=dir_fd)
        try:
            st = os.fstat(fd)
            if not stat.S_ISREG(st.st_mode):
                return None
            if st.st_size > max_bytes:
                return None
            content = os.read(fd, max_bytes + 1)
            if len(content) > max_bytes:
                return None
            return json.loads(content.decode("utf-8"))
        finally:
            os.close(fd)
    except Exception:
        return None
    finally:
        os.close(dir_fd)


def safe_write_json(file_path: Path, data: dict):
    """Atomically writes JSON to file via an exclusive temporary file in the dir_fd."""
    try:
        dir_fd = get_cache_dir_fd()
    except Exception:
        return
    try:
        content_bytes = json.dumps(data, indent=2).encode("utf-8")
        temp_name = f".{file_path.name}.{os.getpid()}.{time.time()}.tmp"
        flags = os.O_WRONLY | os.O_CREAT | os.O_EXCL | getattr(os, "O_NOFOLLOW", 0)
        fd = os.open(temp_name, flags, 0o600, dir_fd=dir_fd)
        try:
            os.write(fd, content_bytes)
            os.fsync(fd)
        finally:
            os.close(fd)
        os.rename(temp_name, file_path.name, src_dir_fd=dir_fd, dst_dir_fd=dir_fd)
    except Exception:
        pass
    finally:
        os.close(dir_fd)

class NoRedirectHandler(urllib.request.HTTPRedirectHandler):
    def redirect_request(self, req, fp, code, msg, headers, newurl):
        raise urllib.error.HTTPError(req.full_url, code, msg, headers, fp)

def _ipapi_worker(q):
    import urllib.request, urllib.error, json, math, time
    endpoint = "https://ipapi.co/json/"
    try:
        opener = urllib.request.build_opener(NoRedirectHandler())
        req = urllib.request.Request(endpoint, headers={"User-Agent": "solar-nightlight/1.0"})
        with opener.open(req, timeout=5) as resp:
            raw_bytes = resp.read(MAX_HTTP_BYTES + 1)
            if len(raw_bytes) > MAX_HTTP_BYTES: return
            data = json.loads(raw_bytes.decode("utf-8"))
            
            lat = float(data.get("lat") or data.get("latitude") or 0)
            lon = float(data.get("lon") or data.get("longitude") or 0)
            city = str(data.get("city", ""))[:50]
            region = str(data.get("regionName", data.get("region", "")))[:50]
            
            if math.isfinite(lat) and math.isfinite(lon) and -90 <= lat <= 90 and -180 <= lon <= 180:
                q.put({
                    "lat": lat, "lon": lon, "city": city, "region": region, "timestamp": time.time()
                })
    except Exception:
        pass

def fetch_ip_location():
    """Attempts to discover location via HTTPS geolocation service with strict 5s deadline and response caps."""
    import multiprocessing
    q = multiprocessing.Queue()
    p = multiprocessing.Process(target=_ipapi_worker, args=(q,))
    p.start()
    p.join(timeout=5.0)
    
    if p.is_alive():
        p.terminate()
        p.join(timeout=1.0)
        if p.is_alive():
            p.kill()
            p.join()
            
    if not q.empty():
        return q.get()
    return None


def get_location(override_lat=None, override_lon=None):
    """Retrieves location from override args, cache, or auto-detection."""
    if override_lat is not None and override_lon is not None:
        return {
            "lat": override_lat,
            "lon": override_lon,
            "city": "Custom",
            "region": "Manual Coordinates",
            "timestamp": time.time()
        }

    # Check cache
    cached = safe_read_json(LOCATION_CACHE_FILE)
    if cached and "lat" in cached and "lon" in cached:
        cache_age = time.time() - cached.get("timestamp", 0)
        if cache_age < 30 * 86400:
            return cached

    # Try fetching fresh location
    fresh = fetch_ip_location()
    if fresh:
        safe_write_json(LOCATION_CACHE_FILE, fresh)
        return fresh

    # If offline, use cached even if old, or fallback
    cached = safe_read_json(LOCATION_CACHE_FILE)
    if cached and "lat" in cached and "lon" in cached:
        return cached

    return FALLBACK_LOCATION



def compute_solar_times(lat, lon, dt_utc=None):
    """
    Computes astronomical solar event times (UTC) using standard NOAA equations.
    """
    if dt_utc is None:
        dt_utc = datetime.now(timezone.utc)

    day_of_year = dt_utc.timetuple().tm_yday
    # Fractional year in radians
    gamma = 2 * math.pi / 365 * (day_of_year - 1 + (dt_utc.hour - 12) / 24)

    # Equation of time in minutes
    eqtime = 229.18 * (
        0.000075
        + 0.001868 * math.cos(gamma)
        - 0.032077 * math.sin(gamma)
        - 0.014615 * math.cos(2 * gamma)
        - 0.040849 * math.sin(2 * gamma)
    )

    # Solar declination angle in radians
    decl = (
        0.006918
        - 0.399912 * math.cos(gamma)
        + 0.070257 * math.sin(gamma)
        - 0.006758 * math.cos(2 * gamma)
        + 0.000907 * math.sin(2 * gamma)
        - 0.002697 * math.cos(3 * gamma)
        + 0.00148 * math.sin(3 * gamma)
    )

    lat_rad = math.radians(lat)

    def calc_rise_set_minutes(zenith_deg):
        zenith_rad = math.radians(zenith_deg)
        cos_ha = (math.cos(zenith_rad) - math.sin(lat_rad) * math.sin(decl)) / (
            math.cos(lat_rad) * math.cos(decl)
        )
        if cos_ha > 1.0 or cos_ha < -1.0:
            return None, None
        ha_deg = math.degrees(math.acos(cos_ha))
        rise_m = 720 - 4 * (lon + ha_deg) - eqtime
        set_m = 720 - 4 * (lon - ha_deg) - eqtime
        return rise_m, set_m

    dawn_m, dusk_m = calc_rise_set_minutes(96.0)     # Civil twilight
    rise_m, set_m = calc_rise_set_minutes(90.833)   # Official sunrise/sunset

    def to_datetime(minutes):
        if minutes is None:
            return None
        base = datetime(dt_utc.year, dt_utc.month, dt_utc.day, tzinfo=timezone.utc)
        return base + timedelta(minutes=minutes)

    return {
        "dawn": to_datetime(dawn_m),
        "sunrise": to_datetime(rise_m),
        "sunset": to_datetime(set_m),
        "dusk": to_datetime(dusk_m),
    }


def calculate_current_target(lat, lon, day_temp, night_temp, transition_mins, now_utc=None):
    """
    Determines current solar phase and smoothly interpolated target temperature.
    """
    if now_utc is None:
        now_utc = datetime.now(timezone.utc)

    today_times = compute_solar_times(lat, lon, now_utc)
    sunrise = today_times["sunrise"]
    sunset = today_times["sunset"]

    if not sunrise or not sunset:
        return "DAY", day_temp, today_times

    trans_half = timedelta(minutes=transition_mins / 2.0)
    dawn_start = sunrise - trans_half
    dawn_end = sunrise + trans_half
    dusk_start = sunset - trans_half
    dusk_end = sunset + trans_half

    if now_utc < dawn_start:
        return "NIGHT", night_temp, today_times
    elif dawn_start <= now_utc <= dawn_end:
        total_seconds = (dawn_end - dawn_start).total_seconds()
        elapsed = (now_utc - dawn_start).total_seconds()
        progress = max(0.0, min(1.0, elapsed / total_seconds))
        weight = (1.0 - math.cos(math.pi * progress)) / 2.0
        target = round(night_temp + weight * (day_temp - night_temp))
        return "SUNRISE_TRANSITION", target, today_times
    elif dawn_end < now_utc < dusk_start:
        return "DAY", day_temp, today_times
    elif dusk_start <= now_utc <= dusk_end:
        total_seconds = (dusk_end - dusk_start).total_seconds()
        elapsed = (now_utc - dusk_start).total_seconds()
        progress = max(0.0, min(1.0, elapsed / total_seconds))
        weight = (1.0 - math.cos(math.pi * progress)) / 2.0
        target = round(day_temp - weight * (day_temp - night_temp))
        return "SUNSET_TRANSITION", target, today_times
    else:
        return "NIGHT", night_temp, today_times


def run_bounded(cmd, timeout=2.0, max_bytes=1024):
    import select
    import shutil
    import signal
    
    cmd0 = shutil.which(cmd[0])
    if not cmd0:
        return -1, "", ""
    cmd[0] = cmd0

    try:
        proc = subprocess.Popen(
            cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True,
            start_new_session=True
        )
        os.set_blocking(proc.stdout.fileno(), False)
        os.set_blocking(proc.stderr.fileno(), False)
        
        out, err = "", ""
        end_time = time.time() + timeout
        overflow = False
        
        while time.time() < end_time and proc.poll() is None:
            rem = end_time - time.time()
            if rem <= 0:
                break
            rlist, _, _ = select.select([proc.stdout, proc.stderr], [], [], rem)
            if proc.stdout in rlist:
                chunk = proc.stdout.read(max_bytes - len(out) + 1)
                if chunk:
                    out += chunk
                    if len(out) > max_bytes:
                        overflow = True
                        break
            if proc.stderr in rlist:
                chunk = proc.stderr.read(max_bytes - len(err) + 1)
                if chunk:
                    err += chunk
                    if len(err) > max_bytes:
                        overflow = True
                        break
                        
        if proc.poll() is None or overflow:
            try:
                os.killpg(proc.pid, signal.SIGTERM)
                proc.wait(timeout=1)
            except Exception:
                pass
            if proc.poll() is None:
                try:
                    os.killpg(proc.pid, signal.SIGKILL)
                    proc.wait(timeout=1)
                except Exception:
                    pass
            if overflow:
                return -1, "", "Overflow"
                
        if not overflow and proc.returncode is not None:
            try:
                chunk = proc.stdout.read(max_bytes - len(out) + 1)
                if chunk:
                    out += chunk
                    if len(out) > max_bytes: return -1, "", "Overflow"
            except Exception: pass
            
        return proc.returncode if proc.returncode is not None else -1, out, err

    except Exception:
        if 'proc' in locals() and proc.poll() is None:
            try:
                os.killpg(proc.pid, signal.SIGKILL)
                proc.wait(timeout=1)
            except Exception:
                pass
        return -1, "", ""


hyprsunset_proc = None

def get_hyprsunset_temp():
    """Queries currently applied temperature from hyprsunset."""
    code, out, _ = run_bounded(["hyprctl", "hyprsunset", "temperature"], timeout=2.0)
    if code == 0 and out:
        for word in out.split():
            if word.isdigit():
                return int(word)
    return None


def ensure_hyprsunset_running():
    """Ensures hyprsunset is running and its IPC socket is responsive."""
    global hyprsunset_proc
    import shutil
    import signal
    
    code, out, err = run_bounded(["hyprctl", "hyprsunset", "temperature"], timeout=2.0)
    combined = (out or "") + " " + (err or "")
    if code == 0 and "couldn't connect" not in combined.lower():
        return

    # If IPC is unreachable, kill our tracked instance if it exists
    if hyprsunset_proc is not None:
        try:
            os.killpg(hyprsunset_proc.pid, signal.SIGTERM)
            hyprsunset_proc.wait(timeout=2)
        except Exception:
            try:
                os.killpg(hyprsunset_proc.pid, signal.SIGKILL)
                hyprsunset_proc.wait()
            except Exception: pass
        hyprsunset_proc = None

    # Spawn a new instance
    try:
        cmd0 = shutil.which("hyprsunset")
        if cmd0:
            hyprsunset_proc = subprocess.Popen(
                [cmd0],
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                start_new_session=True
            )
            time.sleep(1.0)
    except Exception:
        pass


def apply_temperature(target_temp):
    """Sets hyprsunset temperature via hyprctl with deadlines."""
    ensure_hyprsunset_running()
    
    code1, _, _ = run_bounded(["hyprctl", "hyprsunset", "temperature", str(target_temp)], timeout=2.0)
    code2, _, _ = run_bounded(["omarchy-shell", "-q", "nightlight", "refresh"], timeout=2.0)
    
    return code1 == 0


def save_state(state):
    safe_write_json(STATE_FILE, state)


def load_state():
    state = safe_read_json(STATE_FILE)
    return state if isinstance(state, dict) else {}



def run_daemon(args):
    loc = get_location(args.lat, args.lon)
    lat = loc["lat"]
    lon = loc["lon"]

    print(f"[solar-nightlight] Running with location: {loc.get('city', 'Unknown')}, {loc.get('region', '')} ({lat:.4f}, {lon:.4f})")
    print(f"[solar-nightlight] Config: Day={args.day_temp}K, Night={args.night_temp}K, Transition={args.transition_mins}m, Interval={args.interval}s")

    state = load_state()
    override_active = state.get("override_active", False)
    override_phase = state.get("override_phase", None)
    last_set_temp = state.get("last_set_temp", None)

    while True:
        try:
            ensure_hyprsunset_running()
            now_utc = datetime.now(timezone.utc)
            phase, target_temp, times = calculate_current_target(
                lat, lon, args.day_temp, args.night_temp, args.transition_mins, now_utc
            )

            current_actual_temp = get_hyprsunset_temp()

            # Check if user manually changed temperature
            if current_actual_temp is not None:
                compare_temp = last_set_temp if last_set_temp is not None else target_temp
                if abs(current_actual_temp - compare_temp) > 80:
                    if not override_active:
                        print(f"[solar-nightlight] Detected manual override to {current_actual_temp}K (phase: {phase}). Auto-adjustment paused.")
                        override_active = True
                        override_phase = phase
                        save_state({
                            "override_active": True,
                            "override_phase": phase,
                            "last_set_temp": last_set_temp,
                            "current_phase": phase,
                            "target_temp": target_temp,
                            "actual_temp": current_actual_temp,
                            "updated_at": time.time()
                        })

            # If override is active, check if solar phase has changed to reset it
            if override_active:
                if override_phase and phase != override_phase:
                    print(f"[solar-nightlight] Phase changed from {override_phase} to {phase}. Clearing manual override.")
                    override_active = False
                    override_phase = None
                    save_state({
                        "override_active": False,
                        "override_phase": None,
                        "last_set_temp": last_set_temp,
                        "current_phase": phase,
                        "target_temp": target_temp,
                        "actual_temp": current_actual_temp,
                        "updated_at": time.time()
                    })
                else:
                    time.sleep(args.interval)
                    continue

            # Apply target temp if needed (threshold 20K to reduce hyprctl calls during micro-steps)
            if current_actual_temp is None or abs(current_actual_temp - target_temp) >= 20:
                if apply_temperature(target_temp):
                    last_set_temp = target_temp
                    print(f"[solar-nightlight] Applied {target_temp}K (Phase: {phase})")

            save_state({
                "override_active": override_active,
                "override_phase": override_phase,
                "last_set_temp": last_set_temp,
                "current_phase": phase,
                "target_temp": target_temp,
                "actual_temp": current_actual_temp,
                "updated_at": time.time()
            })

        except Exception as err:
            print(f"[solar-nightlight] Error in loop tick: {err}", file=sys.stderr)

        time.sleep(args.interval)


def print_status(args):
    loc = get_location(args.lat, args.lon)
    lat = loc["lat"]
    lon = loc["lon"]
    now_utc = datetime.now(timezone.utc)
    local_tz = datetime.now().astimezone().tzinfo

    phase, target_temp, times = calculate_current_target(
        lat, lon, args.day_temp, args.night_temp, args.transition_mins, now_utc
    )
    current_actual = get_hyprsunset_temp()
    state = load_state()

    is_override = state.get("override_active", False)
    if not is_override and current_actual is not None and abs(current_actual - target_temp) > 80:
        is_override = True
        override_text = f"Active ({current_actual}K, Target: {target_temp}K)"
    elif is_override:
        override_text = f"Active (Phase: {state.get('override_phase', phase)}, Temp: {current_actual}K)"
    else:
        override_text = "Inactive"

    print("--- solar-nightlight Status ---")
    print(f"Location:           {loc.get('city', 'Unknown')}, {loc.get('region', '')} ({lat:.4f}, {lon:.4f})")
    print(f"Current Local Time: {datetime.now().strftime('%Y-%m-%d %H:%M:%S %Z')}")
    print(f"Dawn (Civil):       {times['dawn'].astimezone(local_tz).strftime('%H:%M:%S') if times['dawn'] else 'N/A'}")
    print(f"Sunrise:            {times['sunrise'].astimezone(local_tz).strftime('%H:%M:%S') if times['sunrise'] else 'N/A'}")
    print(f"Sunset:             {times['sunset'].astimezone(local_tz).strftime('%H:%M:%S') if times['sunset'] else 'N/A'}")
    print(f"Dusk (Civil):       {times['dusk'].astimezone(local_tz).strftime('%H:%M:%S') if times['dusk'] else 'N/A'}")
    print(f"Solar Phase:        {phase}")
    print(f"Target Temperature: {target_temp}K")
    print(f"Actual hyprsunset:  {current_actual}K" if current_actual else "Actual hyprsunset:  Not Running / Unknown")
    print(f"Manual Override:    {override_text}")


def main():
    parser = argparse.ArgumentParser(description="Astronomical solar nightlight daemon for hyprsunset")
    parser.add_argument("--status", action="store_true", help="Show current solar times, phase, and temperature status")
    parser.add_argument("--force", action="store_true", help="Force immediate reset of manual overrides and apply solar target")
    parser.add_argument("--daemon", action="store_true", help="Run in continuous background daemon mode")
    parser.add_argument("--day-temp", type=int, default=DEFAULT_DAY_TEMP, help=f"Daytime color temperature (default: {DEFAULT_DAY_TEMP}K)")
    parser.add_argument("--night-temp", type=int, default=DEFAULT_NIGHT_TEMP, help=f"Nighttime color temperature (default: {DEFAULT_NIGHT_TEMP}K)")
    parser.add_argument("--transition-mins", type=int, default=DEFAULT_TRANSITION_MINUTES, help=f"Transition window in minutes (default: {DEFAULT_TRANSITION_MINUTES}m)")
    parser.add_argument("--interval", type=int, default=DEFAULT_INTERVAL_SECONDS, help=f"Check interval in seconds (default: {DEFAULT_INTERVAL_SECONDS}s)")
    parser.add_argument("--lat", type=float, default=None, help="Latitude override")
    parser.add_argument("--lon", type=float, default=None, help="Longitude override")

    args = parser.parse_args()

    if args.force:
        save_state({})
        print("[solar-nightlight] Reset manual override. Applying current solar target...")
        loc = get_location(args.lat, args.lon)
        phase, target_temp, _ = calculate_current_target(
            loc["lat"], loc["lon"], args.day_temp, args.night_temp, args.transition_mins
        )
        apply_temperature(target_temp)
        print(f"[solar-nightlight] Applied {target_temp}K ({phase}).")
        sys.exit(0)

    if args.status:
        print_status(args)
        sys.exit(0)

    run_daemon(args)


if __name__ == "__main__":
    main()
